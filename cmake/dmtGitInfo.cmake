# Build-time script (cmake -P): writes the git identity of the source tree to
# DMT_GIT_INFO_OUT, rewriting it only when it changed, so only build_info.cpp
# recompiles after a commit or an edit.
#   -DDMT_SOURCE_DIR=<repo> -DDMT_GIT_INFO_OUT=<header>
set(_sha "unknown")
set(_dirty 0)
set(_known 0)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${DMT_SOURCE_DIR}/.git")
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
    WORKING_DIRECTORY "${DMT_SOURCE_DIR}"
    OUTPUT_VARIABLE _out
    RESULT_VARIABLE _rc
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
  )
  if(_rc EQUAL 0)
    set(_sha "${_out}")
    set(_known 1)
    # The paths that go into a build, untracked files included (the source
    # globs pick up new files); bench/scripts/run_suite.py checks the same.
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" status --porcelain -- lib include src bench
              tests cmake CMakeLists.txt
      WORKING_DIRECTORY "${DMT_SOURCE_DIR}"
      OUTPUT_VARIABLE _status
      RESULT_VARIABLE _rc
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
    )
    if(NOT _rc EQUAL 0 OR NOT _status STREQUAL "")
      set(_dirty 1)
    endif()
  endif()
endif()
set(_content
    "// Generated by cmake/dmtGitInfo.cmake at build time. Do not edit.\n"
    "#pragma once\n"
    "#define DMT_GIT_SHA \"${_sha}\"\n"
    "#define DMT_GIT_DIRTY ${_dirty}\n"
    "#define DMT_BUILD_INFO_DIRTY_STR \"${_dirty}\"\n"
    "#define DMT_GIT_KNOWN ${_known}\n"
)
string(CONCAT _content ${_content})
set(_old "")
if(EXISTS "${DMT_GIT_INFO_OUT}")
  file(READ "${DMT_GIT_INFO_OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${DMT_GIT_INFO_OUT}" "${_content}")
endif()
