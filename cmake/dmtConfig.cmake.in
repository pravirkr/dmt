
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Static dmt archives reference FFTW, the OpenMP runtime and (in a CUDA build)
# the CUDA runtime and cuFFT; shared builds link all of them privately. The
# installed headers never need CUDA. FindFFTW.cmake is installed next to this
# file.
if(NOT @DMT_BUILT_AS_SHARED@)
  find_dependency(FFTW COMPONENTS FLOAT_LIB)
  find_dependency(OpenMP COMPONENTS CXX)
  if(@DMT_BUILT_WITH_CUDA@)
    find_dependency(CUDAToolkit)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dmtTargets.cmake")

check_required_components(dmt)
