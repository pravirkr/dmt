# Doxyfile for dmt (Dispersion Measure Transform)
# Generates XML for Sphinx / Breathe integration.
#
# Paths are relative to docs/. Run Doxygen from that directory:
#   cd docs && doxygen Doxyfile

PROJECT_NAME           = "dmt"
PROJECT_NUMBER         = "0.2.0"
PROJECT_BRIEF          = "Fast, Accurate Dispersion Measure Transform for Radio Astronomy"
OUTPUT_DIRECTORY       = _build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = ../include/dmt
FILE_PATTERNS          = *.hpp *.h *.cuh
EXTENSION_MAPPING      = h=C++ hpp=C++ cuh=C++
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */detail/* */tests/* */bench/*

# Extraction options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../include

# Warnings and logging. Do not promote warnings to errors: a missing
# optional header (CUDA, spdlog) must not fail the docs build.
QUIET                  = YES
WARNINGS               = YES
WARN_AS_ERROR          = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# Output formats: XML only for Breathe
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Preprocessor / Macro handling.
# DMT_ENABLE_CUDA is defined so the CUDA class docstrings in the headers
# are extracted. CUDA types stay as written in those headers.
# Leave DMT_ENABLE_OPENMP undefined so omp.h is not required.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = ../include
PREDEFINED             = DMT_ENABLE_CUDA=1
EXPAND_AS_DEFINED      =
SKIP_FUNCTION_MACROS   = YES
